# Copy this file to .env.local and fill in the values.

# Final live domain (no trailing slash). Used for canonical URLs, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://www.mashventures.in

# Public contact details (shown on the site and in structured data)
NEXT_PUBLIC_CONTACT_EMAIL=mashventuresindia@gmail.com
NEXT_PUBLIC_PHONE=+919003490627
# WhatsApp number in international format, digits only, e.g. 919003490627
NEXT_PUBLIC_WHATSAPP=919003490627

# Social profiles (optional, used for Google "sameAs" links)
NEXT_PUBLIC_LINKEDIN=https://www.linkedin.com/in/mash-ventures-529792446
NEXT_PUBLIC_INSTAGRAM=https://www.instagram.com/mashventures

# Analytics (optional)
NEXT_PUBLIC_GA_ID=

# Email Enquiry Service via Resend (https://resend.com)
RESEND_API_KEY=
CONTACT_TO_EMAIL=mashventuresindia@gmail.com
CONTACT_FROM_EMAIL="MASH VENTURES <onboarding@resend.dev>"

# Backwards-compatible aliases
ENQUIRY_TO_EMAIL=mashventuresindia@gmail.com
ENQUIRY_FROM_EMAIL="MASH VENTURES <onboarding@resend.dev>"

# Google Search Console verification token (optional)
NEXT_PUBLIC_GSC_VERIFICATION=
